{
  "name": "AutoSemi",
  "displayName": "AutoSemi",
  "description": "Automatically inserts semicolons at the end of lines as you type",
  "version": "0.1.5",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "icon": "images/Logo_optimized.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:java",
    "onLanguage:csharp",
    "onLanguage:cpp"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && npm run test:unit && npm run test:integration",
    "test-compile": "tsc -p ./ --outDir out-test",
    "test:unit": "node --test out/test/logic.test.js",
    "test:integration": "node out/test/run.js",
    "package": "vsce package"
  },
  "publisher": "Moayad",
  "repository": {
    "type": "git",
    "url": "https://github.com/MoayadAlshehry/AutoSemi.git"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.103.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "^5.9.2"
  },
  "contributes": {
    "configuration": {
      "title": "AutoSemi",
      "properties": {
        "autoSemi.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the AutoSemi extension"
        },
        "autoSemi.languages": {
          "type": "array",
          "default": [
            "javascript",
            "typescript",
            "java"
          ],
          "description": "Languages to apply auto semicolon insertion to"
        },
        "autoSemi.skipComments": {
          "type": "boolean",
          "default": true,
          "description": "Skip semicolon insertion in comments"
        },
        "autoSemi.skipStrings": {
          "type": "boolean",
          "default": true,
          "description": "Skip semicolon insertion inside strings"
        },
        "autoSemi.debounceDelay": {
          "type": "number",
          "default": 50,
          "description": "Debounce delay in milliseconds to prevent excessive parsing",
          "minimum": 0,
          "maximum": 500
        },
        "autoSemi.enableForJavascript": {
          "type": "boolean",
          "default": true,
          "description": "Enable for JavaScript files"
        },
        "autoSemi.enableForTypescript": {
          "type": "boolean",
          "default": true,
          "description": "Enable for TypeScript files"
        },
        "autoSemi.enableForJava": {
          "type": "boolean",
          "default": true,
          "description": "Enable for Java files"
        },
        "autoSemi.enableForCsharp": {
          "type": "boolean",
          "default": false,
          "description": "Enable for C# files"
        },
        "autoSemi.enableForCpp": {
          "type": "boolean",
          "default": false,
          "description": "Enable for C++ files"
        },
        "autoSemi.postEditDelay": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "maximum": 500,
          "description": "Wait for editor indentation before inserting a semicolon (milliseconds)."
        }
      }
    }
  },
  "license": "MIT"
}
